# Supabase Configuration (safe for client bundles - RLS enforces security)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Groq AI (server-side only — NEVER expose in EXPO_PUBLIC_* variables)
# Store as Supabase Edge Function secret:
# supabase secrets set GROQ_API_KEY=gsk_your_new_groq_key_here
# Do NOT add EXPO_PUBLIC_GROQ_API_KEY here
